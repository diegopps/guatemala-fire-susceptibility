    given-names: Diegopablo
    email: diegopab@pik-potsdam.de
    affiliation: Potsdam Institute for Climate Impact Research (PIK)
    orcid: "https://orcid.org/0009-0001-8443-7378"
repository-code: "https://github.com/diegopps/guatemala-fire-susceptibility"
license: MIT
keywords:
  - forest fire
  - fire susceptibility
  - Guatemala
  - machine learning
  - climate change
  - climate projections
  - ISIMIP3b
  - CHELSA

